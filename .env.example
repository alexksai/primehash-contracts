# Copy to .env (never commit .env). Foundry loads it automatically.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional, for contract verification on Etherscan (free key at etherscan.io/myapikey)
ETHERSCAN_API_KEY=
# Treasury: receives the 1.5% treasury fee and can add reserve liquidity. Use a Safe on mainnet.
TREASURY=
# Wei paired with 21,000 PRIME at launch (sets the starting price). 0.02 ETH = 20000000000000000
LAUNCH_ETH=20000000000000000

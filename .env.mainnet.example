# Copy to .env.mainnet (never commit it). Used by ./script/deploy-mainnet.sh
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
# Treasury: receives the 1.5% hook fee and controls reserve liquidity. A Safe multisig is recommended.
TREASURY=
# Wei paired with 21,000 PRIME at launch (sets the starting price). 0.045 ETH = 45000000000000000
LAUNCH_ETH=45000000000000000
# Name of the keystore created with: cast wallet import primehash-deployer --interactive
DEPLOYER_ACCOUNT=primehash-deployer
# Refuse to deploy above this gas price (gwei)
MAX_GWEI=3
# Optional: Etherscan verification (free key at etherscan.io/myapikey)
ETHERSCAN_API_KEY=
